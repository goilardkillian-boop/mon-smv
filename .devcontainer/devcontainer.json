{
  "name": "Mon SMV · dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Mon SMV",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": {
    "server": "python3 -m http.server 8080"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ritwickdey.LiveServer",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
